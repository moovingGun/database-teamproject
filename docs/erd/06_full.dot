digraph "06_full" {
  graph [rankdir=TB, fontname="Apple SD Gothic Neo", fontsize=13, bgcolor="white", nodesep=0.35, pad=0.3, splines=true, newrank=true, ranksep=0.8];
  node  [shape=plaintext, fontname="Apple SD Gothic Neo", fontsize=11];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9];
  label="SI-PMS 전체 ERD — 테이블 28개 · 외래키 43개 (IE 표기)  ·  ⊗ = 배타적 서브타입, 이중선 = 완전(전체), 주황 글자 = 판별자"; labelloc=t; fontsize=16;
  subgraph cluster_hr { label="직원 · 계정 · 기술"; style="rounded,filled"; fillcolor="#e8eefc55"; color="#e8eefc"; fontsize=14;
    "employee" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>employee</B>  <FONT POINT-SIZE="10" COLOR="#555555">직원</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>emp_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> emp_no<FONT POINT-SIZE="9" COLOR="#777777">  char(7)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> emp_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> resident_reg_no<FONT POINT-SIZE="9" COLOR="#777777">  char(14) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> education_level<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> hire_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> emp_type<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> email<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> phone<FONT POINT-SIZE="9" COLOR="#777777">  varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> status<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> updated_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
    "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>emp_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> skill_grade<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> career_start_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> grade_updated_at<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR></TABLE>>];
    "staff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>staff</B>  <FONT POINT-SIZE="10" COLOR="#555555">지원직</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>emp_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> department<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> job_title<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> is_training_manager<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR></TABLE>>];
    "user_account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>user_account</B>  <FONT POINT-SIZE="10" COLOR="#555555">로그인 계정</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>emp_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> login_id<FONT POINT-SIZE="9" COLOR="#777777">  varchar(30) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> password_hash<FONT POINT-SIZE="9" COLOR="#777777">  varchar(255) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> auth_role<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> is_active<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> last_login_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
    "skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>skill_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> skill_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> category<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR></TABLE>>];
    "employee_skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>employee_skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자 보유 기술</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>emp_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>skill_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> proficiency<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> years_used<FONT POINT-SIZE="9" COLOR="#777777">  decimal(3,1) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> last_used_date<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR></TABLE>>];
    "grade_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>grade_history</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술등급 변경 이력</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>history_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> old_grade<FONT POINT-SIZE="9" COLOR="#777777">  enum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> new_grade<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> changed_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> changed_by_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> reason<FONT POINT-SIZE="9" COLOR="#777777">  varchar(200)</FONT></TD></TR></TABLE>>];
    "cat_employee" [margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#6b7280"><TR><TD PORT="in"><FONT POINT-SIZE="20">⊗</FONT></TD></TR><TR><TD BORDER="1" SIDES="B" WIDTH="26" HEIGHT="3" FIXEDSIZE="TRUE"></TD></TR><TR><TD BORDER="1" SIDES="B" WIDTH="26" HEIGHT="3" FIXEDSIZE="TRUE" PORT="out"></TD></TR></TABLE>>, xlabel=<<FONT POINT-SIZE="9" COLOR="#b45309">emp_type</FONT>>];
