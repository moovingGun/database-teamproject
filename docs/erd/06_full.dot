    "cat_employee" -> "developer" [dir=none, tailport="out:s", color="#6b7280", penwidth=1.1];
    "cat_employee" -> "staff" [dir=none, tailport="out:s", color="#6b7280", penwidth=1.1];
  }
  subgraph cluster_prj { label="발주처 · 프로젝트 · 투입"; style="rounded,filled"; fillcolor="#e7f6ec55"; color="#e7f6ec"; fontsize=14;
