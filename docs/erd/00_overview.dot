digraph "00_overview" {
  graph [rankdir=TB, fontname="Apple SD Gothic Neo", fontsize=13, bgcolor="white", nodesep=0.35, pad=0.3, splines=true, newrank=true, ranksep=0.65];
  node  [shape=plaintext, fontname="Apple SD Gothic Neo", fontsize=11];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9];
  subgraph cluster_hr { label="직원 · 계정 · 기술"; style="rounded,filled"; fillcolor="#e8eefc55"; color="#e8eefc"; fontsize=14;
    "employee" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>employee</B>  <FONT POINT-SIZE="10" COLOR="#555555">직원</FONT></TD></TR></TABLE>>];
    "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR></TABLE>>];
    "staff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>staff</B>  <FONT POINT-SIZE="10" COLOR="#555555">지원직</FONT></TD></TR></TABLE>>];
    "user_account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>user_account</B>  <FONT POINT-SIZE="10" COLOR="#555555">로그인 계정</FONT></TD></TR></TABLE>>];
    "skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술</FONT></TD></TR></TABLE>>];
    "employee_skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>employee_skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자 보유 기술</FONT></TD></TR></TABLE>>];
    "grade_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>grade_history</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술등급 변경 이력</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_prj { label="발주처 · 프로젝트 · 투입"; style="rounded,filled"; fillcolor="#e7f6ec55"; color="#e7f6ec"; fontsize=14;
    "client" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처(고객사)</FONT></TD></TR></TABLE>>];
    "client_contact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client_contact</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처 담당자</FONT></TD></TR></TABLE>>];
    "project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트</FONT></TD></TR></TABLE>>];
    "project_skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project_skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 요구 기술</FONT></TD></TR></TABLE>>];
    "job_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>job_role</B>  <FONT POINT-SIZE="10" COLOR="#555555">직무</FONT></TD></TR></TABLE>>];
    "assignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>assignment</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 투입</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_eval { label="프로젝트 평가"; style="rounded,filled"; fillcolor="#fdf1e355"; color="#fdf1e3"; fontsize=14;
    "evaluation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>evaluation</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 평가</FONT></TD></TR></TABLE>>];
    "customer_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>customer_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객 평가</FONT></TD></TR></TABLE>>];
    "pm_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>pm_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">PM 평가</FONT></TD></TR></TABLE>>];
    "peer_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>peer_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">동료 평가</FONT></TD></TR></TABLE>>];
    "eval_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_item</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 항목</FONT></TD></TR></TABLE>>];
    "eval_detail" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_detail</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 상세</FONT></TD></TR></TABLE>>];
    "eval_type_weight" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_type_weight</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 유형별 가중치</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_chg { label="시나리오 A · 변경요청 승인"; style="rounded,filled"; fillcolor="#f3e8fd55"; color="#f3e8fd"; fontsize=14;
    "change_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_request</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객사 변경요청</FONT></TD></TR></TABLE>>];
    "change_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_review</B>  <FONT POINT-SIZE="10" COLOR="#555555">변경 검토안</FONT></TD></TR></TABLE>>];
    "change_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_history</B>  <FONT POINT-SIZE="10" COLOR="#555555">변경 적용 이력</FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_edu { label="시나리오 B · 역량개선 · 교육"; style="rounded,filled"; fillcolor="#fde8ee55"; color="#fde8ee"; fontsize=14;
    "training_course" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_course</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육과정</FONT></TD></TR></TABLE>>];
    "training_session" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_session</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육일정</FONT></TD></TR></TABLE>>];
    "development_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>development_plan</B>  <FONT POINT-SIZE="10" COLOR="#555555">역량개선계획</FONT></TD></TR></TABLE>>];
    "training_enrollment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_enrollment</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육 신청 및 이수</FONT></TD></TR></TABLE>>];
  }
  "developer" -> "assignment" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "project" -> "assignment" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
