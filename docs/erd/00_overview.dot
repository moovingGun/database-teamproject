    lg_c [shape=plaintext, label=""]; lg_d [shape=plaintext, label="1 : 0..1  (서브타입 · 1:1)"];
    lg_e [shape=plaintext, label=""]; lg_f [shape=plaintext, label="0..1 : 0..N  (FK NULL 허용)"];
