  label="시나리오 A · 변경요청 승인  (실선: 이 영역 · 점선: 다른 영역)"; labelloc=t; fontsize=15;
  "change_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_request</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객사 변경요청</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>cr_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> cr_no<FONT POINT-SIZE="9" COLOR="#777777">  varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> project_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> contact_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> received_by_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> request_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> title<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> content<FONT POINT-SIZE="9" COLOR="#777777">  varchar(1000) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> reason<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> status<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "change_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_review</B>  <FONT POINT-SIZE="10" COLOR="#555555">변경 검토안</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>review_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> cr_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> version_no<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> reviewer_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> proposed_end_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> additional_amount<FONT POINT-SIZE="9" COLOR="#777777">  decimal(15,0) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> review_comment<FONT POINT-SIZE="9" COLOR="#777777">  varchar(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> reviewed_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> decision<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> decided_by_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> decided_at<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> decision_reason<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> consent<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> consent_contact_id<FONT POINT-SIZE="9" COLOR="#777777">  int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> consent_date<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> consent_evidence<FONT POINT-SIZE="9" COLOR="#777777">  varchar(300)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> consent_recorded_by<FONT POINT-SIZE="9" COLOR="#777777">  int</FONT></TD></TR></TABLE>>];
  "change_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_history</B>  <FONT POINT-SIZE="10" COLOR="#555555">변경 적용 이력</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>history_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK UK </FONT> review_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> before_end_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> after_end_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> before_amount<FONT POINT-SIZE="9" COLOR="#777777">  decimal(15,0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> after_amount<FONT POINT-SIZE="9" COLOR="#777777">  decimal(15,0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> applied_by_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> applied_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "client_contact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client_contact</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처 담당자</FONT></TD></TR></TABLE>>];
  "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR></TABLE>>];
  "employee" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>employee</B>  <FONT POINT-SIZE="10" COLOR="#555555">직원</FONT></TD></TR></TABLE>>];
  "project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트</FONT></TD></TR></TABLE>>];
  "employee" -> "change_history" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "change_review" -> "change_history" [dir=both, arrowtail=teetee, arrowhead=teeodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "client_contact" -> "change_request" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "change_request" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "project" -> "change_request" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "client_contact" -> "change_review" [dir=both, arrowtail=teeodot, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "change_request" -> "change_review" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "employee" -> "change_review" [dir=both, arrowtail=teeodot, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
