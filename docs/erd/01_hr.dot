  "cat_employee" [margin=0, width=0, height=0, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#6b7280"><TR><TD PORT="in"><FONT POINT-SIZE="20">⊗</FONT></TD><TD BORDER="1" SIDES="R" WIDTH="3" HEIGHT="26" FIXEDSIZE="TRUE"></TD><TD BORDER="1" SIDES="R" WIDTH="3" HEIGHT="26" FIXEDSIZE="TRUE" PORT="out"></TD></TR></TABLE>>, xlabel=<<FONT POINT-SIZE="9" COLOR="#b45309">emp_type</FONT>>];
