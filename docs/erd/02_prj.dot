digraph "02_prj" {
  graph [rankdir=LR, fontname="Apple SD Gothic Neo", fontsize=13, bgcolor="white", nodesep=0.35, pad=0.3, splines=true, newrank=true, ranksep=0.9];
  node  [shape=plaintext, fontname="Apple SD Gothic Neo", fontsize=11];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9];
  label="발주처 · 프로젝트 · 투입  (실선: 이 영역 · 점선: 다른 영역)"; labelloc=t; fontsize=15;
  "client" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처(고객사)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>client_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> client_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> business_reg_no<FONT POINT-SIZE="9" COLOR="#777777">  char(12) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> industry<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> address<FONT POINT-SIZE="9" COLOR="#777777">  varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> phone<FONT POINT-SIZE="9" COLOR="#777777">  varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "client_contact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client_contact</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처 담당자</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>contact_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> client_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> contact_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> position<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> email<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> phone<FONT POINT-SIZE="9" COLOR="#777777">  varchar(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> is_active<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR></TABLE>>];
  "project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>project_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> project_code<FONT POINT-SIZE="9" COLOR="#777777">  varchar(12)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> project_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> client_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> start_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> end_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> actual_end_date<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> status<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> contract_amount<FONT POINT-SIZE="9" COLOR="#777777">  decimal(15,0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> description<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> updated_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "project_skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project_skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 요구 기술</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>project_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>skill_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> required_level<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR></TABLE>>];
  "job_role" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>job_role</B>  <FONT POINT-SIZE="10" COLOR="#555555">직무</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>role_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> role_code<FONT POINT-SIZE="9" COLOR="#777777">  varchar(10) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> role_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(30) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> min_grade<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> sort_order<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR></TABLE>>];
  "assignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>assignment</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 투입</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>assignment_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> project_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> role_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> start_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> end_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> participation_rate<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> note<FONT POINT-SIZE="9" COLOR="#777777">  varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "change_request" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_request</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객사 변경요청</FONT></TD></TR></TABLE>>];
  "change_review" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#f3e8fd" ALIGN="LEFT"><B>change_review</B>  <FONT POINT-SIZE="10" COLOR="#555555">변경 검토안</FONT></TD></TR></TABLE>>];
  "customer_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>customer_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객 평가</FONT></TD></TR></TABLE>>];
  "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR></TABLE>>];
  "development_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>development_plan</B>  <FONT POINT-SIZE="10" COLOR="#555555">역량개선계획</FONT></TD></TR></TABLE>>];
  "evaluation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>evaluation</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 평가</FONT></TD></TR></TABLE>>];
  "skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술</FONT></TD></TR></TABLE>>];
  "developer" -> "assignment" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
