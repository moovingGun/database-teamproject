digraph "05_edu" {
  graph [rankdir=LR, fontname="Apple SD Gothic Neo", fontsize=13, bgcolor="white", nodesep=0.35, pad=0.3, splines=true, newrank=true, ranksep=0.9];
  node  [shape=plaintext, fontname="Apple SD Gothic Neo", fontsize=11];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9];
  label="시나리오 B · 역량개선 · 교육  (실선: 이 영역 · 점선: 다른 영역)"; labelloc=t; fontsize=15;
  "training_course" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_course</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육과정</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>course_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> course_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> field<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> skill_id<FONT POINT-SIZE="9" COLOR="#777777">  int</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> description<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR></TABLE>>];
  "training_session" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_session</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육일정</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>session_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> course_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> start_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> end_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> place<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> capacity<FONT POINT-SIZE="9" COLOR="#777777">  smallint ●</FONT></TD></TR></TABLE>>];
  "development_plan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>development_plan</B>  <FONT POINT-SIZE="10" COLOR="#555555">역량개선계획</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>plan_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> project_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> course_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> manager_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> improvement_goal<FONT POINT-SIZE="9" COLOR="#777777">  varchar(200) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> reason<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> due_date<FONT POINT-SIZE="9" COLOR="#777777">  date ●</FONT></TD></TR></TABLE>>];
  "training_enrollment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fde8ee" ALIGN="LEFT"><B>training_enrollment</B>  <FONT POINT-SIZE="10" COLOR="#555555">교육 신청 및 이수</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>enroll_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> plan_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> session_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> applied_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> status<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> attended<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> processed_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime</FONT></TD></TR></TABLE>>];
  "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR></TABLE>>];
  "project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트</FONT></TD></TR></TABLE>>];
  "skill" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>skill</B>  <FONT POINT-SIZE="10" COLOR="#555555">기술</FONT></TD></TR></TABLE>>];
  "staff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>staff</B>  <FONT POINT-SIZE="10" COLOR="#555555">지원직</FONT></TD></TR></TABLE>>];
  "training_course" -> "development_plan" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "development_plan" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "staff" -> "development_plan" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "project" -> "development_plan" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "skill" -> "training_course" [dir=both, arrowtail=teeodot, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "development_plan" -> "training_enrollment" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "training_session" -> "training_enrollment" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "training_course" -> "training_session" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
}