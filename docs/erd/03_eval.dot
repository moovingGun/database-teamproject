digraph "03_eval" {
  graph [rankdir=LR, fontname="Apple SD Gothic Neo", fontsize=13, bgcolor="white", nodesep=0.35, pad=0.3, splines=true, newrank=true, ranksep=0.9];
  node  [shape=plaintext, fontname="Apple SD Gothic Neo", fontsize=11];
  edge  [fontname="Apple SD Gothic Neo", fontsize=9];
  label="프로젝트 평가  (실선: 이 영역 · 점선: 다른 영역)"; labelloc=t; fontsize=15;
  "evaluation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>evaluation</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트 평가</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>eval_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> project_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> evaluatee_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> eval_type<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> status<FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> eval_date<FONT POINT-SIZE="9" COLOR="#777777">  date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> overall_comment<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> created_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR></TABLE>>];
  "customer_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>customer_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">고객 평가</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>eval_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> contact_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> requested_by_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> requested_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> access_token<FONT POINT-SIZE="9" COLOR="#777777">  char(32) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> reported_at<FONT POINT-SIZE="9" COLOR="#777777">  datetime</FONT></TD></TR></TABLE>>];
  "pm_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>pm_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">PM 평가</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>eval_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> evaluator_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> recommend_incentive<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR></TABLE>>];
  "peer_eval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>peer_eval</B>  <FONT POINT-SIZE="10" COLOR="#555555">동료 평가</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>eval_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">FK    </FONT> evaluator_emp_id<FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> is_anonymous<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR></TABLE>>];
  "eval_item" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_item</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 항목</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>item_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">UK    </FONT> item_code<FONT POINT-SIZE="9" COLOR="#777777">  varchar(20) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> item_name<FONT POINT-SIZE="9" COLOR="#777777">  varchar(50) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> description<FONT POINT-SIZE="9" COLOR="#777777">  varchar(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> weight<FONT POINT-SIZE="9" COLOR="#777777">  decimal(3,2) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> is_active<FONT POINT-SIZE="9" COLOR="#777777">  tinyint(1) ●</FONT></TD></TR></TABLE>>];
  "eval_detail" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_detail</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 상세</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>eval_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK FK </FONT> <B>item_id</B><FONT POINT-SIZE="9" COLOR="#777777">  int ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> score<FONT POINT-SIZE="9" COLOR="#777777">  tinyint ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> comment<FONT POINT-SIZE="9" COLOR="#777777">  varchar(500)</FONT></TD></TR></TABLE>>];
  "eval_type_weight" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6"><TR><TD BGCOLOR="#fdf1e3" ALIGN="LEFT"><B>eval_type_weight</B>  <FONT POINT-SIZE="10" COLOR="#555555">평가 유형별 가중치</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">PK    </FONT> <B>eval_type</B><FONT POINT-SIZE="9" COLOR="#777777">  enum ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> weight<FONT POINT-SIZE="9" COLOR="#777777">  decimal(3,2) ●</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b4fd6">      </FONT> description<FONT POINT-SIZE="9" COLOR="#777777">  varchar(100)</FONT></TD></TR></TABLE>>];
  "client_contact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>client_contact</B>  <FONT POINT-SIZE="10" COLOR="#555555">발주처 담당자</FONT></TD></TR></TABLE>>];
  "developer" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e8eefc" ALIGN="LEFT"><B>developer</B>  <FONT POINT-SIZE="10" COLOR="#555555">개발자</FONT></TD></TR></TABLE>>];
  "project" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#8a94a6" STYLE="dashed"><TR><TD BGCOLOR="#e7f6ec" ALIGN="LEFT"><B>project</B>  <FONT POINT-SIZE="10" COLOR="#555555">프로젝트</FONT></TD></TR></TABLE>>];
  "client_contact" -> "customer_eval" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "evaluation" -> "customer_eval" [dir=both, arrowtail=teetee, arrowhead=teeodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "customer_eval" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "evaluation" -> "eval_detail" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "eval_item" -> "eval_detail" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "evaluation" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "project" -> "evaluation" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "evaluation" -> "peer_eval" [dir=both, arrowtail=teetee, arrowhead=teeodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "peer_eval" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "evaluation" -> "pm_eval" [dir=both, arrowtail=teetee, arrowhead=teeodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
  "developer" -> "pm_eval" [dir=both, arrowtail=teetee, arrowhead=crowodot, color="#6b7280", penwidth=1.1, arrowsize=0.9];
}